\f0\b\fs36 \cf0 \strokec2 LLM Agent Specifications\
\pard\pardeftab720\sa280\partightenfactor0

\fs28 \cf0 L1: CWE Gap Filler\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 Problem:
\f1\b0  ~25,000 NVD CVEs have no CWE classification (NVD-CWE-noinfo or NVD-CWE-Other). These CVEs are invisible to the CWE
\f2 \uc0\u8594 
\f1 regulation traversal chain, meaning they can't trigger compliance alerts.\

\f0\b Gap Detection Query:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 FOR v IN vulnerabilities\
    LET has_cwe = LENGTH(\
        FOR e IN has_weakness\
            FILTER e._from == CONCAT("vulnerabilities/", v._key)\
            RETURN 1\
    ) > 0\
    FILTER !has_cwe AND v.description != null AND v.description != ""\
    RETURN \{_key: v._key, cve_id: v.cve_id, description: v.description\}\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 LLM Task:
\f1\b0  Given CVE description, classify into 1-3 CWE IDs with confidence scores.\

\f0\b Model:
\f1\b0  Claude Haiku 4.5 (fast, cheap, good enough for classification)\

\f0\b Prompt Strategy:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 SYSTEM = """You are a CWE classifier. Given a CVE description, identify the most\
applicable CWE weakness(es). Return ONLY valid JSON.\
\
Rules:\
- Return 1-3 CWEs, ranked by confidence\
- Only use CWE IDs that exist (you'll be given a reference list)\
- Confidence must be between 0.0 and 1.0\
- If the description is too vague, return confidence < 0.5\
"""\
\
USER = """CVE Description: \{description\}\
\
Reference CWE list (top 200 most common):\
\{cwe_reference_list\}\
\
Return JSON: \{\{"classifications": [\{\{"cwe_id": "CWE-79", "confidence": 0.92, "reasoning": "..."\}\}]\}\}"""\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Output Schema (Pydantic):
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 class CWEClassification(BaseModel):\
    cwe_id: str          # CWE-79\
    confidence: float    # 0.0-1.0\
    reasoning: str       # Brief justification\
\
class CWEGapFillerOutput(BaseModel):\
    classifications: list[CWEClassification]\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Auto-Apply Threshold:
\f1\b0  confidence >= 0.85 
\f2 \uc0\u8594 
\f1  automatically create 
\f5\fs26 has_weakness
\f1\fs24  edge 
\f0\b Review Queue:
\f1\b0  0.5 <= confidence < 0.85 
\f2 \uc0\u8594 
\f1  flagged for human review 
\f0\b Discard:
\f1\b0  confidence < 0.5 
\f2 \uc0\u8594 
\f1  not applied\

\f0\b Graph Writes:
\f1\b0 \
