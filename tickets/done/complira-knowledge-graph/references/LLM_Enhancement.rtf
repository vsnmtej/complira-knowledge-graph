\f0\b\fs28 \cf0 \strokec2 L3: VEX Justification Synthesizer\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 Problem:
\f1\b0  For every (CVE, component) pair in a customer's SBOM, a VEX status is needed: 
\f5\fs26 affected
\f1\fs24 , 
\f5\fs26 not_affected
\f1\fs24 , 
\f5\fs26 fixed
\f1\fs24 , or 
\f5\fs26 under_investigation
\f1\fs24 . Generating these manually takes 15-30 minutes each. Customers typically have 50-500 active CVEs.\

\f0\b This is the highest-value LLM agent \'97 it's what customers pay for.
\f1\b0 \

\f0\b Evidence Collection Query (per CVE+component pair):
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 LET vuln = DOCUMENT("vulnerabilities/CVE_2024_8966")\
LET comp = DOCUMENT("components/pkg_pypi_requests_2_31_0")\
\
LET cwe_data = (\
    FOR cwe IN 1..1 OUTBOUND vuln has_weakness\
        RETURN \{cwe_id: cwe.cwe_id, name: cwe.name, description: cwe.description\}\
)\
\
LET epss = \{score: vuln.epss_score, percentile: vuln.epss_percentile\}\
\
LET is_kev = LENGTH(FOR k IN kev_entries FILTER k._key == vuln._key RETURN 1) > 0\
\
LET exploits = (\
    FOR exp IN 1..1 OUTBOUND vuln has_exploit\
        RETURN \{source: exp.source, type: exp.type, rank: exp.rank\}\
)\
\
LET hardening = (\
    FOR h IN 1..1 OUTBOUND comp has_hardening_profile\
        RETURN \{pie: h.pie, nx: h.nx, aslr: h.aslr, canary: h.stack_canary, relro: h.relro\}\
)\
\
LET sast_evidence = (\
    FOR f IN sast_findings\
        FILTER f.tenant_id == @tenant\
        FOR e IN found_in_component\
            FILTER e._from == f._id AND e._to == comp._id\
            FOR cwe_edge IN classified_as_weakness\
                FILTER cwe_edge._from == f._id\
                RETURN \{rule: f.rule_id, file: f.file_path, line: f.start_line,\
                        cwe: DOCUMENT(cwe_edge._to).cwe_id, severity: f.severity\}\
)\
\
LET dast_evidence = (\
    FOR f IN dast_findings\
        FILTER f.tenant_id == @tenant\
        FOR e IN found_in_component\
            FILTER e._from == f._id AND e._to == comp._id\
            RETURN \{url: f.url, cwe: f.cwe_ids, severity: f.severity, confidence: f.confidence\}\
)\
\
LET dependency_path = (\
    FOR v, e, p IN 1..10 OUTBOUND comp depends_on\
        RETURN p.vertices[*].purl\
)\
\
LET multi_scanner = (\
    FOR a IN vuln_assertion\
        FILTER a._from == vuln._id AND a._to == comp._id\
        RETURN \{source: a.source, detected: a.detected, method: a.detection_method,\
                backport: a.backport_status\}\
)\
\
RETURN \{\
    vulnerability: \{cve_id: vuln.cve_id, description: vuln.description,\
                    cvss: vuln.cvss_v31, epss: epss, is_kev: is_kev\},\
    weakness: cwe_data,\
    exploits: exploits,\
    component: \{purl: comp.purl, version: comp.version\},\
    hardening: hardening,\
    sast_findings: sast_evidence,\
    dast_findings: dast_evidence,\
    scanner_consensus: multi_scanner,\
    dependency_path: dependency_path\
\}\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Model:
\f1\b0  Claude Sonnet 4.5 for standard CVEs, Claude Opus for complex/high-severity\

\f0\b Prompt Strategy:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 SYSTEM = """You are a vulnerability assessment expert generating VEX (Vulnerability\
Exploitability eXchange) justifications for regulatory compliance (FDA 524B, EU CRA).\
\
Your output must be:\
1. A VEX status: affected | not_affected | fixed | under_investigation\
2. A justification that references SPECIFIC evidence from the provided data\
3. Impact statement if affected\
4. Every claim must cite the evidence source (scanner name, file:line, etc.)\
\
VEX "not_affected" justifications (pick the most applicable):\
- component_not_present: Vulnerable code not included in build\
- vulnerable_code_not_reachable: Code exists but execution path blocked\
- vulnerable_code_cannot_be_controlled_by_adversary: Input validation prevents exploitation\
- inline_mitigations_already_exist: Hardening (ASLR, NX, etc.) prevents exploit primitive\
\
CRITICAL: Never fabricate evidence. If you can't determine status with high confidence\
from the provided data, use "under_investigation".\
"""\
\
USER = """Generate a VEX justification for:\
\
CVE: \{evidence.vulnerability.cve_id\}\
Description: \{evidence.vulnerability.description\}\
CVSS: \{evidence.vulnerability.cvss\}\
EPSS: \{evidence.vulnerability.epss\}\
In CISA KEV: \{evidence.vulnerability.is_kev\}\
\
Component: \{evidence.component.purl\}\
CWE(s): \{evidence.weakness\}\
\
Exploit availability: \{evidence.exploits\}\
Binary hardening: \{evidence.hardening\}\
SAST findings: \{evidence.sast_findings\}\
DAST findings: \{evidence.dast_findings\}\
Scanner consensus: \{evidence.scanner_consensus\}\
Dependency path: \{evidence.dependency_path\}\
\
Return JSON:\
\{\{\
    "status": "not_affected",\
    "justification": "vulnerable_code_not_reachable",\
    "impact_statement": "...",\
    "detail": "The component includes the vulnerable function X in file Y (line Z),\
               however binary hardening analysis shows full RELRO and stack canaries\
               are enabled, and no SAST findings match CWE-787 in the component's\
               code paths. The CVE requires a buffer overflow primitive which is\
               mitigated by the NX and ASLR protections confirmed by checksec.",\
    "evidence_citations": [\
        \{\{"type": "binary_hardening", "source": "checksec", "detail": "NX=true, ASLR=true, RELRO=full"\}\},\
        \{\{"type": "sast_absence", "source": "semgrep", "detail": "No CWE-787 findings in component"\}\},\
        \{\{"type": "scanner_consensus", "source": "4/4 scanners", "detail": "grype, trivy, osv, pip_audit"\}\}\
    ],\
    "confidence": 0.92,\
    "recommended_action": "No action required. Document VEX not_affected status."\
\}\}"""\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Output Schema:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 class EvidenceCitation(BaseModel):\
    type: str            # binary_hardening|sast_finding|dast_finding|scanner_consensus|epss|kev\
    source: str          # Tool/scanner name\
    detail: str          # Specific evidence\
\
class VEXJustification(BaseModel):\
    status: Literal["affected", "not_affected", "fixed", "under_investigation"]\
    justification: str | None   # VEX justification category (for not_affected)\
    impact_statement: str\
    detail: str                 # Full reasoning with evidence references\
    evidence_citations: list[EvidenceCitation]\
    confidence: float           # 0.0-1.0\
    recommended_action: str\
\pard\pardeftab720\sa240\partightenfactor0

