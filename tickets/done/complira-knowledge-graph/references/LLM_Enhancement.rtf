\f5\b0\fs26 \cf0 # src/complira_graph/agents/llm/base_llm_agent.py\
from anthropic import Anthropic\
from ..base import BaseIngestionAgent\
import hashlib\
import json\
from datetime import datetime\
\
class BaseLLMAgent(BaseIngestionAgent):\
    """Extended base class for LLM-powered enrichment agents."""\
\
    def __init__(self, db, config):\
        super().__init__(db, config)\
        self.client = Anthropic()  # Uses ANTHROPIC_API_KEY env var\
        self.model = config.get("model", "claude-haiku-4-5-20251001")\
        self.auto_apply_threshold = config.get("auto_apply_threshold", 0.85)\
        self.review_threshold = config.get("review_threshold", 0.50)\
        self.max_concurrent = config.get("max_concurrent_llm", 10)\
        self.cost_tracker = \{"input_tokens": 0, "output_tokens": 0\}\
\
    async def call_llm(self, system: str, user: str,\
                       response_model=None, max_tokens=1024) -> dict:\
        """Make an LLM call with structured output parsing and cost tracking."""\
        input_hash = hashlib.sha256(f"\{system\}\{user\}".encode()).hexdigest()[:16]\
\
        response = self.client.messages.create(\
            model=self.model,\
            max_tokens=max_tokens,\
            system=system,\
            messages=[\{"role": "user", "content": user\}],\
        )\
\
        # Track costs\
        self.cost_tracker["input_tokens"] += response.usage.input_tokens\
        self.cost_tracker["output_tokens"] += response.usage.output_tokens\
\
        # Parse JSON from response\
        text = response.content[0].text\
        # Strip markdown code fences if present\
        if text.startswith("```"):\
            text = text.split("\\n", 1)[1].rsplit("```", 1)[0]\
        parsed = json.loads(text)\
\
        # Validate with Pydantic if model provided\
        if response_model:\
            parsed = response_model.model_validate(parsed).model_dump()\
\
        return parsed, input_hash\
\
    def create_enrichment_record(self, agent_name: str, output: dict,\
                                  confidence: float, input_hash: str) -> dict:\
        """Create an llm_enrichments document with full provenance."""\
        return \{\
            "_collection": "llm_enrichments",\
            "_key": f"\{agent_name\}_\{input_hash\}_\{datetime.utcnow().strftime('%Y%m%d%H%M%S')\}",\
            "agent": agent_name,\
            "model": self.model,\
            "confidence": confidence,\
            "timestamp": datetime.utcnow().isoformat(),\
            "input_context_hash": input_hash,\
            "output": output,\
            "validated": confidence >= self.auto_apply_threshold,\
            "human_reviewed": False,\
            "review_decision": None,\
            "cost_usd": self._estimate_cost(),\
            "input_tokens": self.cost_tracker["input_tokens"],\
            "output_tokens": self.cost_tracker["output_tokens"],\
        \}\
\
    def _estimate_cost(self) -> float:\
        """Estimate cost based on model and token counts."""\
        # Pricing as of Feb 2026 (approximate)\
        pricing = \{\
            "claude-haiku-4-5-20251001":   \{"input": 0.25,  "output": 1.25\},\
            "claude-sonnet-4-5-20250929":  \{"input": 3.00,  "output": 15.00\},\
            "claude-opus-4-6":             \{"input": 15.00, "output": 75.00\},\
        \}\
        p = pricing.get(self.model, \{"input": 3.0, "output": 15.0\})\
        return (\
            (self.cost_tracker["input_tokens"] / 1_000_000) * p["input"] +\
            (self.cost_tracker["output_tokens"] / 1_000_000) * p["output"]\
        )\
