\f0\b Step 1: Graph traversal builds the threat model evidence package
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 -- For a customer's product, gather all threat-relevant data\
LET product_components = (\
    FOR c IN components FILTER c.tenant_id == @tenant RETURN c\
)\
LET attack_surface = (\
    FOR comp IN product_components\
        FOR vuln, e IN 1..1 INBOUND comp affects\
            FOR cwe IN 1..1 OUTBOUND vuln has_weakness\
                FOR capec IN 1..1 INBOUND cwe capec_relates_to_cwe\
                    FOR technique IN 1..1 OUTBOUND capec capec_maps_to_attack\
                        RETURN DISTINCT \{\
                            component: comp.purl,\
                            cve: vuln.cve_id,\
                            cwe: cwe.cwe_id,\
                            cwe_name: cwe.name,\
                            attack_pattern: capec.name,\
                            technique: technique.technique_id,\
                            technique_name: technique.name,\
                            tactic: technique.tactic_names[0],\
                            epss: vuln.epss_score,\
                            is_kev: vuln._key IN kev_keys\
                        \}\
)\
LET defenses = (\
    FOR comp IN product_components\
        FOR h IN 1..1 OUTBOUND comp has_hardening_profile\
            RETURN \{component: comp.purl, hardening: h\}\
)\
LET mitigations = (\
    FOR t IN attack_surface\
        FOR ctrl IN 1..1 OUTBOUND DOCUMENT(CONCAT("attack_techniques/", t.technique)) technique_mitigated_by_control\
            RETURN \{technique: t.technique, control: ctrl.control_id, control_title: ctrl.title\}\
)\
\pard\pardeftab720\sa240\partightenfactor0

