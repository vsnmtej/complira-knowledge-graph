\f3\b0\fs26 \cf0 # src/complira_graph/agents/base.py\
from abc import ABC, abstractmethod\
from dataclasses import dataclass, field\
from datetime import datetime\
from typing import Any\
import structlog\
from tenacity import retry, wait_exponential_jitter, stop_after_attempt\
from prometheus_client import Counter, Histogram, Gauge\
\
logger = structlog.get_logger()\
\
@dataclass\
class IngestionResult:\
    source: str\
    documents_upserted: int = 0\
    edges_upserted: int = 0\
    documents_skipped: int = 0\
    errors: int = 0\
    duration_seconds: float = 0.0\
    checkpoint: str | None = None  # Last-processed marker\
    version: str | None = None     # Source data version\
\
RECORDS_TOTAL = Counter("ingestion_records_total", "Records processed", ["source", "operation"])\
DURATION = Histogram("ingestion_duration_seconds", "Ingestion duration", ["source"])\
ERRORS = Counter("ingestion_errors_total", "Ingestion errors", ["source"])\
LAST_SUCCESS = Gauge("ingestion_last_success_timestamp", "Last successful ingestion", ["source"])\
\
\
class BaseIngestionAgent(ABC):\
    """Base class for all data source ingestion agents."""\
\
    def __init__(self, db, config: dict):\
        self.db = db          # ArangoDB database handle\
        self.config = config  # Agent-specific config from agents.yaml\
        self.log = logger.bind(agent=self.name)\
\
    @property\
    @abstractmethod\
    def name(self) -> str:\
        """Unique agent identifier (e.g., 'nvd', 'epss', 'attack')."""\
        ...\
\
    @property\
    @abstractmethod\
    def dependencies(self) -> list[str]:\
        """Agent names that must complete before this one (for DAG ordering)."""\
        ...\
\
    @abstractmethod\
    async def check_for_updates(self) -> bool:\
        """Return True if source has new data since last ingestion."""\
        ...\
\
    @abstractmethod\
    async def fetch_data(self) -> Any:\
        """Fetch raw data from source (API, file download, git pull)."""\
        ...\
\
    @abstractmethod\
    def transform(self, raw_data: Any) -> tuple[list[dict], list[dict]]:\
        """Transform raw data 
\f5 \uc0\u8594 
\f3  (documents, edges) with deterministic _key values."""\
        ...\
\
    def load(self, documents: list[dict], edges: list[dict]) -> IngestionResult:\
        """Bulk upsert documents and edges into ArangoDB."""\
        result = IngestionResult(source=self.name)\
\
        for collection_name, batch in self._group_by_collection(documents):\
            coll = self.db.collection(collection_name)\
            stats = coll.import_bulk(\
                batch,\
                on_duplicate="update",\
                halt_on_error=False,\
            )\
            result.documents_upserted += stats.get("created", 0) + stats.get("updated", 0)\
            result.errors += stats.get("errors", 0)\
\
        for collection_name, batch in self._group_by_collection(edges):\
            coll = self.db.collection(collection_name)\
            stats = coll.import_bulk(\
                batch,\
                on_duplicate="update",\
                halt_on_error=False,\
            )\
            result.edges_upserted += stats.get("created", 0) + stats.get("updated", 0)\
            result.errors += stats.get("errors", 0)\
\
        return result\
\
    @retry(\
        wait=wait_exponential_jitter(initial=1, max=60),\
        stop=stop_after_attempt(3),\
        reraise=True,\
    )\
    async def run(self) -> IngestionResult:\
        """Full ingestion cycle: check 
\f5 \uc0\u8594 
\f3  fetch 
\f5 \uc0\u8594 
\f3  transform 
\f5 \uc0\u8594 
\f3  load."""\
        start = datetime.utcnow()\
        self.log.info("starting_ingestion")\
\
        has_updates = await self.check_for_updates()\
        if not has_updates:\
            self.log.info("no_updates_found")\
            return IngestionResult(source=self.name)\
\
        raw_data = await self.fetch_data()\
        documents, edges = self.transform(raw_data)\
        result = self.load(documents, edges)\
\
        result.duration_seconds = (datetime.utcnow() - start).total_seconds()\
        self._save_checkpoint(result.checkpoint)\
        self._emit_metrics(result)\
        self.log.info("ingestion_complete", **result.__dict__)\
        return result\
\
    def _group_by_collection(self, records: list[dict]):\
        """Group records by their '_collection' field for batch loading."""\
        from itertools import groupby\
        from operator import itemgetter\
        sorted_records = sorted(records, key=itemgetter("_collection"))\
        for collection_name, group in groupby(sorted_records, key=itemgetter("_collection")):\
            batch = [\{k: v for k, v in r.items() if k != "_collection"\} for r in group]\
            yield collection_name, batch\
\
    def _save_checkpoint(self, checkpoint: str | None):\
        """Persist last-processed marker to disk."""\
        if checkpoint:\
            import json\
            from pathlib import Path\
            cp_dir = Path("data/checkpoints")\
            cp_dir.mkdir(parents=True, exist_ok=True)\
            (cp_dir / f"\{self.name\}.json").write_text(\
                json.dumps(\{"checkpoint": checkpoint, "timestamp": datetime.utcnow().isoformat()\})\
            )\
\
    def _load_checkpoint(self) -> str | None:\
        """Load last-processed marker from disk."""\
        import json\
        from pathlib import Path\
        cp_file = Path(f"data/checkpoints/\{self.name\}.json")\
        if cp_file.exists():\
            return json.loads(cp_file.read_text()).get("checkpoint")\
        return None\
\
    def _emit_metrics(self, result: IngestionResult):\
        RECORDS_TOTAL.labels(source=self.name, operation="upsert").inc(\
            result.documents_upserted + result.edges_upserted\
        )\
        ERRORS.labels(source=self.name).inc(result.errors)\
        DURATION.labels(source=self.name).observe(result.duration_seconds)\
        LAST_SUCCESS.labels(source=self.name).set_to_current_time()\
