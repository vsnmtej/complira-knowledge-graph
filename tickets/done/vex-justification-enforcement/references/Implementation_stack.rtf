\f3\b0\fs26 \cf0 # src/complira_graph/cli.py\
import asyncio\
import click\
from rich.console import Console\
from rich.table import Table\
\
console = Console()\
\
@click.group()\
def cli():\
    """Complira Knowledge Graph Engine."""\
    pass\
\
@cli.command()\
def seed():\
    """Run full initial seed (all agents in dependency order)."""\
    from complira_graph.orchestrator.schedules import full_seed_flow\
    asyncio.run(full_seed_flow())\
\
@cli.command()\
@click.argument("agent_name")\
def run(agent_name):\
    """Run a single agent by name."""\
    from complira_graph.orchestrator.schedules import run_agent_task\
    asyncio.run(run_agent_task(agent_name))\
\
@cli.command()\
def status():\
    """Show status of all agents (last run, checkpoint, record counts)."""\
    import json\
    from pathlib import Path\
    from complira_graph.orchestrator.dag import AGENT_DEPENDENCIES\
\
    table = Table(title="Agent Status")\
    table.add_column("Agent", style="cyan")\
    table.add_column("Last Run", style="green")\
    table.add_column("Checkpoint", style="yellow")\
    table.add_column("Dependencies", style="dim")\
\
    for name in sorted(AGENT_DEPENDENCIES.keys()):\
        cp_file = Path(f"data/checkpoints/\{name\}.json")\
        if cp_file.exists():\
            cp = json.loads(cp_file.read_text())\
            table.add_row(name, cp["timestamp"][:19], str(cp["checkpoint"])[:30],\
                         ", ".join(AGENT_DEPENDENCIES[name]) or "\'97")\
        else:\
            table.add_row(name, "never", "\'97",\
                         ", ".join(AGENT_DEPENDENCIES[name]) or "\'97")\
\
    console.print(table)\
\
@cli.command()\
def serve():\
    """Start scheduled ingestion engine with metrics endpoint."""\
    from prometheus_client import start_http_server\
    start_http_server(8000)  # Metrics at :8000/metrics\
    console.print("[green]Metrics server started on :8000[/green]")\
\
    # Start Prefect worker or APScheduler\
    from complira_graph.orchestrator.schedules import start_scheduler\
    start_scheduler()  # Blocks forever\
\
@cli.command()\
def validate():\
    """Validate graph integrity \'97 check for broken edges, orphaned nodes."""\
    from complira_graph.config import get_config\
    from complira_graph.db import setup_database\
\
    config = get_config()\
    db = setup_database(config)\
\
    # Check for edges pointing to non-existent documents\
    checks = [\
        ("has_weakness", "vulnerabilities", "weaknesses"),\
        ("affects", "vulnerabilities", "components"),\
        ("exploited_in_wild", "vulnerabilities", "kev_entries"),\
        ("technique_exploits_weakness", "attack_techniques", "weaknesses"),\
        ("maps_to_requirement", "weaknesses", "regulatory_requirements"),\
    ]\
\
    for edge_coll, from_coll, to_coll in checks:\
        query = f"""\
        FOR e IN \{edge_coll\}\
            LET from_exists = DOCUMENT(e._from) != null\
            LET to_exists = DOCUMENT(e._to) != null\
            FILTER !from_exists OR !to_exists\
            COLLECT WITH COUNT INTO broken\
            RETURN broken\
        """\
        cursor = db.aql.execute(query)\
        broken = next(cursor)\
        status = "
\f6 \uc0\u9989 
\f3 " if broken == 0 else f"
\f6 \uc0\u10060 
\f3  \{broken\} broken"\
        console.print(f"  \{edge_coll\}: \{status\}")\
\
if __name__ == "__main__":\
    cli()\
