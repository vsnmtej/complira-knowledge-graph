\f3\b0\fs26 \cf0 # src/complira_graph/agents/attack.py\
import json\
from pathlib import Path\
import httpx\
from .base import BaseIngestionAgent\
\
STIX_URL = (\
    "https://raw.githubusercontent.com/mitre-attack/attack-stix-data"\
    "/master/enterprise-attack/enterprise-attack.json"\
)\
\
class ATTACKAgent(BaseIngestionAgent):\
    name = "attack"\
    dependencies = []  # ATT&CK is root \'97 CAPEC and D3FEND depend on it\
\
    async def check_for_updates(self) -> bool:\
        """Check ATT&CK version via STIX bundle x-mitre-collection."""\
        async with httpx.AsyncClient(timeout=120) as client:\
            # Just fetch the index to check version without downloading full bundle\
            resp = await client.get(\
                "https://raw.githubusercontent.com/mitre-attack/attack-stix-data"\
                "/master/index.json"\
            )\
            resp.raise_for_status()\
            index = resp.json()\
            # Latest enterprise version\
            latest = index["collections"][0]["versions"][-1]["version"]\
            return latest != self._load_checkpoint()\
\
    async def fetch_data(self):\
        """Download full STIX 2.1 bundle (~25 MB)."""\
        async with httpx.AsyncClient(timeout=180) as client:\
            resp = await client.get(STIX_URL)\
            resp.raise_for_status()\
            return resp.json()\
\
    def transform(self, bundle: dict):\
        documents = []\
        edges = []\
        version = None\
\
        for obj in bundle.get("objects", []):\
            obj_type = obj.get("type")\
\
            if obj_type == "x-mitre-collection":\
                version = obj.get("x_mitre_version")\
\
            elif obj_type == "attack-pattern":\
                # Techniques and sub-techniques\
                ext = obj.get("external_references", [])\
                tech_ref = next((r for r in ext if r.get("source_name") == "mitre-attack"), None)\
                if not tech_ref:\
                    continue\
\
                tech_id = tech_ref["external_id"]\
                key = tech_id.replace(".", "_")\
                is_sub = obj.get("x_mitre_is_subtechnique", False)\
\
                # Extract tactic names from kill_chain_phases\
                tactics = [\
                    p["phase_name"] for p in obj.get("kill_chain_phases", [])\
                    if p.get("kill_chain_name") == "mitre-attack"\
                ]\
\
                documents.append(\{\
                    "_collection": "attack_techniques",\
                    "_key": key,\
                    "technique_id": tech_id,\
                    "name": obj.get("name"),\
                    "description": obj.get("description", ""),\
                    "is_subtechnique": is_sub,\
                    "tactic_names": tactics,\
                    "platforms": obj.get("x_mitre_platforms", []),\
                    "deprecated": obj.get("x_mitre_deprecated", False),\
                    "stix_id": obj["id"],\
                    "mitre_version": version,\
                    "domain": "enterprise-attack",\
                \})\
\
            elif obj_type == "relationship":\
                src_ref = obj.get("source_ref", "")\
                tgt_ref = obj.get("target_ref", "")\
                rel_type = obj.get("relationship_type", "")\
\
                # We'll resolve STIX IDs to _keys in a post-processing step\
                # Store raw relationships for now\
                edges.append(\{\
                    "_collection": "_stix_relationships",  # Temporary staging\
                    "source_stix_id": src_ref,\
                    "target_stix_id": tgt_ref,\
                    "relationship_type": rel_type,\
                    "description": obj.get("description", ""),\
                \})\
\
            elif obj_type == "intrusion-set":\
                ext = obj.get("external_references", [])\
                group_ref = next((r for r in ext if r.get("source_name") == "mitre-attack"), None)\
                if not group_ref:\
                    continue\
\
                group_id = group_ref["external_id"]\
                documents.append(\{\
                    "_collection": "threat_groups",\
                    "_key": group_id,\
                    "group_id": group_id,\
                    "name": obj.get("name"),\
                    "aliases": obj.get("aliases", []),\
                    "description": obj.get("description", ""),\
                \})\
\
        return documents, edges\
