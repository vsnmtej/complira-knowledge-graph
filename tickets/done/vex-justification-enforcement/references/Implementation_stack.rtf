\f3\b0\fs26 \cf0 # src/complira_graph/orchestrator/dag.py\
from graphlib import TopologicalSorter\
import asyncio\
import structlog\
\
logger = structlog.get_logger()\
\
# Agent dependency graph\
AGENT_DEPENDENCIES = \{\
    # Tier 0: Root sources (no dependencies)\
    "cwe":              [],\
    "attack":           [],\
    "oscal":            [],\
    "spdx_licenses":    [],\
    "epss":             [],\
    "cisa_kev":         [],\
    "eol":              [],\
\
    # Tier 1: Depends on root sources\
    "nvd":              ["cwe"],               # CVEs reference CWE IDs\
    "capec":            ["cwe", "attack"],      # Maps CWE 
\f5 \uc0\u8596 
\f3  ATT&CK\
    "d3fend":           ["attack"],             # Counters ATT&CK techniques\
    "atlas":            ["attack"],             # Cross-refs ATT&CK techniques\
    "ctid":             ["attack", "oscal"],    # Maps ATT&CK 
\f5 \uc0\u8594 
\f3  800-53\
    "scf":              ["oscal"],              # Maps SCF 
\f5 \uc0\u8594 
\f3  800-53 + others\
    "osadl":            ["spdx_licenses"],      # License compatibility\
\
    # Tier 2: Depends on Tier 1\
    "osv":              ["cwe"],               # Advisories reference CWE\
    "vulncheck":        ["cwe"],\
    "ghsa":             ["cwe"],\
    "nuclei":           ["cwe"],               # Templates have CWE classification\
    "exploitdb":        [],                    # CVE-keyed, no graph deps\
    "metasploit":       [],\
    "poc_github":       [],\
    "opencre":          ["oscal", "cwe"],      # Links standards + CWEs\
    "deps_dev":         [],\
    "redhat":           ["cwe"],\
\
    # Tier 3: Depends on Tier 2\
    # (future: LLM enrichment agents depend on base data)\
\}\
\
\
async def run_seed(agents: dict, max_concurrent: int = 4):\
    """Execute full seed in dependency order with bounded concurrency."""\
    sorter = TopologicalSorter(AGENT_DEPENDENCIES)\
    sorter.prepare()\
    semaphore = asyncio.Semaphore(max_concurrent)\
    results = \{\}\
\
    async def run_agent(name: str):\
        async with semaphore:\
            logger.info("agent_starting", agent=name)\
            try:\
                result = await agents[name].run()\
                results[name] = result\
                logger.info("agent_complete", agent=name,\
                           docs=result.documents_upserted,\
                           edges=result.edges_upserted,\
                           duration=f"\{result.duration_seconds:.1f\}s")\
            except Exception as e:\
                logger.error("agent_failed", agent=name, error=str(e))\
                results[name] = None\
            finally:\
                sorter.done(name)\
\
    # Process agents in topological order with concurrency\
    while sorter.is_active():\
        ready = sorter.get_ready()\
        if not ready:\
            await asyncio.sleep(0.1)\
            continue\
\
        tasks = [asyncio.create_task(run_agent(name)) for name in ready]\
        # Don't await all \'97 let them complete individually and trigger next tier\
        await asyncio.gather(*tasks, return_exceptions=True)\
\
    return results\
