import re\
\
def cve_key(cve_id: str) -> str:\
    """CVE-2024-1234 
\f5 \uc0\u8594 
\f3  CVE_2024_1234"""\
    return cve_id.replace("-", "_")\
\
def cwe_key(cwe_id: str) -> str:\
    """CWE-79 
\f5 \uc0\u8594 
\f3  CWE_79"""\
    return cwe_id.replace("-", "_")\
\
def purl_key(purl: str) -> str:\
    """pkg:pypi/requests@2.31.0 
\f5 \uc0\u8594 
\f3  pkg_pypi_requests_2_31_0"""\
    return re.sub(r"[^a-zA-Z0-9]", "_", purl).strip("_")\
\
def attack_key(technique_id: str) -> str:\
    """T1059.001 
\f5 \uc0\u8594 
\f3  T1059_001"""\
    return technique_id.replace(".", "_")\
\
def capec_key(capec_id: str) -> str:\
    """CAPEC-66 
\f5 \uc0\u8594 
\f3  CAPEC_66"""\
    return capec_id.replace("-", "_")\
\
def edge_key(from_key: str, rel: str, to_key: str) -> str:\
    """Deterministic edge key from components."""\
    return f"\{from_key\}_\{rel\}_\{to_key\}"\
