\f3\b0\fs26 \cf0 # src/complira_graph/db.py\
from python_arango import ArangoClient\
import yaml\
\
def setup_database(config):\
    """Create all collections, indexes, and named graphs."""\
    client = ArangoClient(hosts=config.arango_url)\
    sys_db = client.db("_system", username=config.arango_user, password=config.arango_pass)\
\
    if not sys_db.has_database("complira"):\
        sys_db.create_database("complira")\
\
    db = client.db("complira", username=config.arango_user, password=config.arango_pass)\
\
    # Document collections\
    DOC_COLLECTIONS = [\
        "vulnerabilities", "weaknesses", "kev_entries", "vulncheck_kev_entries",\
        "exploit_modules", "epss_history", "attack_techniques", "attack_patterns",\
        "atlas_techniques", "d3fend_techniques", "threat_groups",\
        "regulatory_requirements", "oscal_controls", "scf_controls", "opencre_nodes",\
        "components", "cpe_entries", "scorecard_results", "licenses", "package_health",\
        "tool_runs", "binary_hardening_profiles", "sbom_artifacts", "code_metrics",\
        "sast_findings", "dast_findings", "secret_findings", "license_findings",\
        "remediation_tickets", "code_changes", "scan_results", "compliance_events",\
        "generated_documents", "document_claims", "evidence_chains", "llm_enrichments",\
    ]\
\
    EDGE_COLLECTIONS = [\
        "has_weakness", "exploited_in_wild", "has_exploit", "aliases", "affects",\
        "has_epss_history", "technique_exploits_weakness", "capec_relates_to_cwe",\
        "capec_maps_to_attack", "technique_mitigated_by_control",\
        "atlas_maps_to_attack", "d3fend_counters_technique",\
        "maps_to_requirement", "cross_framework_mapping", "opencre_links",\
        "depends_on", "matched_by_cpe", "same_as", "scored_by", "licensed_under",\
        "generated_by_tool", "has_hardening_profile", "sbom_contains",\
        "found_in_component", "classified_as_weakness", "has_code_metrics",\
        "triggers_classification", "vuln_assertion", "known_vulnerable_at_build",\
        "violates_requirement", "tracked_by", "resolved_by", "verified_by",\
        "modifies_component", "reviewed_by", "triggered_compliance_event",\
        "supported_by", "contains_claim", "evidence_chain_link", "enriched_by_llm",\
    ]\
\
    for name in DOC_COLLECTIONS:\
        if not db.has_collection(name):\
            db.create_collection(name)\
\
    for name in EDGE_COLLECTIONS:\
        if not db.has_collection(name):\
            db.create_collection(name, edge=True)\
\
    # Create indexes (persistent only \'97 hash/skiplist are aliases in 3.10+)\
    # High-cardinality lookup fields\
    _ensure_index(db, "vulnerabilities", ["cve_id"], unique=True, cache=True)\
    _ensure_index(db, "vulnerabilities", ["epss_score"])\
    _ensure_index(db, "weaknesses", ["cwe_id"], unique=True, cache=True)\
    _ensure_index(db, "components", ["purl"], unique=True, cache=True)\
    _ensure_index(db, "components", ["ecosystem", "name"])\
    _ensure_index(db, "cpe_entries", ["vendor", "product"])\
    _ensure_index(db, "attack_techniques", ["technique_id"], unique=True, cache=True)\
    _ensure_index(db, "attack_patterns", ["capec_id"], unique=True, cache=True)\
    _ensure_index(db, "oscal_controls", ["control_id"], unique=True, cache=True)\
    _ensure_index(db, "scf_controls", ["scf_id"], unique=True, cache=True)\
    _ensure_index(db, "epss_history", ["cve_id", "date"])\
    _ensure_index(db, "exploit_modules", ["cve_ids[*]"])  # Array index\
    _ensure_index(db, "sast_findings", ["file_path", "rule_id"])\
    _ensure_index(db, "remediation_tickets", ["status", "sla_met"])\
\
    # Tenant isolation indexes (for customer-specific data)\
    for coll in ["tool_runs", "sast_findings", "dast_findings", "secret_findings",\
                  "code_metrics", "remediation_tickets", "sbom_artifacts"]:\
        _ensure_index(db, coll, ["tenant_id"])\
\
    return db\
\
\
def _ensure_index(db, collection, fields, unique=False, cache=False):\
    """Create persistent index if it doesn't exist."""\
    db.collection(collection).add_persistent_index(\
        fields=fields,\
        unique=unique,\
        cache_enabled=cache,\
    )\
