\f3\b0\fs26 \cf0 # src/complira_graph/agents/cwe.py\
import io\
import zipfile\
import httpx\
from lxml import etree\
from .base import BaseIngestionAgent\
\
NS = "http://cwe.mitre.org/cwe-7"\
\
class CWEAgent(BaseIngestionAgent):\
    name = "cwe"\
    dependencies = []  # CWE is a root dependency \'97 others depend on it\
\
    async def check_for_updates(self) -> bool:\
        """Compare stored version against current CWE XML version."""\
        async with httpx.AsyncClient(timeout=120) as client:\
            resp = await client.get("https://cwe.mitre.org/data/xml/cwec_latest.xml.zip")\
            resp.raise_for_status()\
            with zipfile.ZipFile(io.BytesIO(resp.content)) as zf:\
                xml_filename = zf.namelist()[0]\
                with zf.open(xml_filename) as f:\
                    # Read just enough to get version from root element\
                    for event, elem in etree.iterparse(f, events=("start",)):\
                        version = elem.get("Version")\
                        self._raw_zip = resp.content  # Cache for fetch\
                        return version != self._load_checkpoint()\
\
    async def fetch_data(self):\
        """Return cached ZIP content (already downloaded in check)."""\
        return self._raw_zip\
\
    def transform(self, raw_data):\
        documents = []\
        edges = []\
        version = None\
\
        with zipfile.ZipFile(io.BytesIO(raw_data)) as zf:\
            xml_filename = zf.namelist()[0]\
            with zf.open(xml_filename) as f:\
                context = etree.iterparse(f, events=("end",), tag=f"\{\{\{NS\}\}\}Weakness")\
                for event, elem in context:\
                    if version is None:\
                        version = elem.getparent().get("Version")\
\
                    cwe_id = f"CWE-\{elem.get('ID')\}"\
                    key = cwe_id.replace("-", "_")\
\
                    doc = \{\
                        "_collection": "weaknesses",\
                        "_key": key,\
                        "cwe_id": cwe_id,\
                        "name": elem.get("Name"),\
                        "abstraction": elem.get("Abstraction"),\
                        "status": elem.get("Status"),\
                        "description": self._get_text(elem, f"\{\{\{NS\}\}\}Description"),\
                        "likelihood_of_exploit": self._get_text(\
                            elem, f"\{\{\{NS\}\}\}Likelihood_Of_Exploit"\
                        ),\
                    \}\
\
                    # Extract IEC 62443 taxonomy mappings\
                    for mapping in elem.findall(\
                        f".//\{\{\{NS\}\}\}Taxonomy_Mapping[@Taxonomy_Name='ISA/IEC 62443']"\
                    ):\
                        entry_id = self._get_text(mapping, f"\{\{\{NS\}\}\}Entry_ID")\
                        if entry_id:\
                            edges.append(\{\
                                "_collection": "maps_to_requirement",\
                                "_key": f"\{key\}_iec62443_\{entry_id.replace('.', '_')\}",\
                                "_from": f"weaknesses/\{key\}",\
                                "_to": f"regulatory_requirements/IEC_62443_\{entry_id.replace('.', '_')\}",\
                                "source": "cwe_taxonomy",\
                            \})\
\
                    # Parent CWE edges (ChildOf relationships)\
                    for rel in elem.findall(\
                        f".//\{\{\{NS\}\}\}Related_Weakness[@Nature='ChildOf']"\
                    ):\
                        parent_id = rel.get("CWE_ID")\
                        parent_key = f"CWE_\{parent_id\}"\
                        edges.append(\{\
                            "_collection": "has_weakness",\
                            "_key": f"\{key\}_child_of_\{parent_key\}",\
                            "_from": f"weaknesses/\{key\}",\
                            "_to": f"weaknesses/\{parent_key\}",\
                            "type": "ChildOf",\
                            "source": "cwe",\
                        \})\
\
                    documents.append(doc)\
\
                    # Memory management: clear processed element\
                    elem.clear()\
                    while elem.getprevious() is not None:\
                        del elem.getparent()[0]\
\
        return documents, edges\
\
    def _get_text(self, elem, tag):\
        child = elem.find(tag)\
        return child.text if child is not None else None\
