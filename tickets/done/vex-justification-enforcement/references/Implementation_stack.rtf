\f3\b0\fs26 \cf0 # src/complira_graph/agents/epss.py\
import csv\
import gzip\
import io\
from datetime import date, timedelta\
import httpx\
from .base import BaseIngestionAgent\
\
class EPSSAgent(BaseIngestionAgent):\
    name = "epss"\
    dependencies = []  # No dependencies \'97 can run independently\
\
    async def check_for_updates(self) -> bool:\
        """EPSS updates daily \'97 check if today's file exists."""\
        today = date.today().isoformat()\
        last = self._load_checkpoint()\
        return last != today\
\
    async def fetch_data(self):\
        """Download today's EPSS CSV (gzipped, ~6.7 MB)."""\
        today = date.today().isoformat()\
        url = f"https://epss.empiricalsecurity.com/epss_scores-\{today\}.csv.gz"\
        async with httpx.AsyncClient(timeout=60) as client:\
            resp = await client.get(url)\
            if resp.status_code == 404:\
                # Today's file not ready yet \'97 try yesterday\
                yesterday = (date.today() - timedelta(days=1)).isoformat()\
                url = f"https://epss.empiricalsecurity.com/epss_scores-\{yesterday\}.csv.gz"\
                resp = await client.get(url)\
            resp.raise_for_status()\
            return gzip.decompress(resp.content).decode("utf-8"), today\
\
    def transform(self, raw_data):\
        csv_text, score_date = raw_data\
        documents = []\
        edges = []\
\
        reader = csv.DictReader(io.StringIO(csv_text))\
        for row in reader:\
            cve_id = row["cve"]\
            epss = float(row["epss"])\
            percentile = float(row["percentile"])\
            cve_key = cve_id.replace("-", "_")\
\
            # Update EPSS fields directly on vulnerability node\
            documents.append(\{\
                "_collection": "vulnerabilities",\
                "_key": cve_key,\
                "epss_score": epss,\
                "epss_percentile": percentile,\
                "epss_date": score_date,\
            \})\
\
            # Also store in history for time-series analysis\
            history_key = f"\{cve_key\}_\{score_date.replace('-', '')\}"\
            documents.append(\{\
                "_collection": "epss_history",\
                "_key": history_key,\
                "cve_id": cve_id,\
                "date": score_date,\
                "epss": epss,\
                "percentile": percentile,\
            \})\
\
        return documents, edges\
