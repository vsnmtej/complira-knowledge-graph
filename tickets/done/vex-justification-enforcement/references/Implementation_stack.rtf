\f3\b0\fs26 \cf0 # src/complira_graph/orchestrator/schedules.py\
from prefect import flow, task\
from prefect.tasks import task_input_hash\
from datetime import timedelta\
\
@task(retries=3, retry_delay_seconds=[10, 60, 300],\
      cache_key_fn=task_input_hash, cache_expiration=timedelta(hours=1))\
async def run_agent_task(agent_name: str):\
    """Prefect task wrapper for a single agent."""\
    from complira_graph.config import get_config\
    from complira_graph.db import setup_database\
    from complira_graph.agents import get_agent\
\
    config = get_config()\
    db = setup_database(config)\
    agent = get_agent(agent_name, db, config)\
    return await agent.run()\
\
\
@flow(name="complira-full-seed", log_prints=True)\
async def full_seed_flow():\
    """Initial full seed \'97 runs all agents in dependency order."""\
    from complira_graph.orchestrator.dag import run_seed, AGENT_DEPENDENCIES\
    from complira_graph.config import get_config\
    from complira_graph.db import setup_database\
    from complira_graph.agents import get_all_agents\
\
    config = get_config()\
    db = setup_database(config)\
    agents = get_all_agents(db, config)\
    results = await run_seed(agents, max_concurrent=4)\
    print(f"Seed complete: \{sum(1 for r in results.values() if r)\} agents succeeded")\
\
\
@flow(name="complira-hourly")\
async def hourly_flow():\
    """Hourly: KEV + EPSS scores + NVD delta."""\
    await run_agent_task("cisa_kev")\
    await run_agent_task("epss")\
    await run_agent_task("nvd")\
\
\
@flow(name="complira-daily")\
async def daily_flow():\
    """Daily: OSV, VulnCheck, GHSA, exploit sources."""\
    await run_agent_task("osv")\
    await run_agent_task("vulncheck")\
    await run_agent_task("ghsa")\
    await run_agent_task("nuclei")\
    await run_agent_task("exploitdb")\
    await run_agent_task("metasploit")\
    await run_agent_task("poc_github")\
\
\
@flow(name="complira-weekly")\
async def weekly_flow():\
    """Weekly: ATT&CK, D3FEND, deps.dev, EOL, distro data."""\
    await run_agent_task("attack")\
    await run_agent_task("d3fend")\
    await run_agent_task("atlas")\
    await run_agent_task("capec")\
    await run_agent_task("deps_dev")\
    await run_agent_task("eol")\
    await run_agent_task("redhat")\
    await run_agent_task("opencre")\
\
\
@flow(name="complira-monthly")\
async def monthly_flow():\
    """Monthly: Compliance frameworks, licenses."""\
    await run_agent_task("cwe")\
    await run_agent_task("oscal")\
    await run_agent_task("scf")\
    await run_agent_task("ctid")\
    await run_agent_task("spdx_licenses")\
    await run_agent_task("osadl")\
