\f0\b\fs28 \cf0 Simpler Alternative: APScheduler (for early development)\
\pard\pardeftab720\partightenfactor0

\f3\b0\fs26 \cf0 # If you want to start simple and graduate to Prefect later\
from apscheduler.schedulers.background import BackgroundScheduler\
from apscheduler.jobstores.sqlalchemy import SQLAlchemyJobStore\
\
scheduler = BackgroundScheduler(\
    jobstores=\{"default": SQLAlchemyJobStore(url="sqlite:///jobs.db")\},\
    job_defaults=\{"coalesce": True, "max_instances": 1\},\
)\
scheduler.add_job(kev_agent.run, "interval", hours=1, id="kev")\
scheduler.add_job(epss_agent.run, "cron", hour=1, id="epss")\
scheduler.add_job(nvd_agent.run, "interval", hours=2, id="nvd")\
scheduler.start()\
