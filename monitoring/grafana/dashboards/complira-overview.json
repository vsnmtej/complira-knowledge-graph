{
  "dashboard": {
    "title": "Complira Knowledge Graph Overview",
    "tags": ["complira", "knowledge-graph"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Agent Execution Status",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(complira_agent_runs_total{status=\"success\"})",
            "legendFormat": "Successful",
            "refId": "A"
          },
          {
            "expr": "sum(complira_agent_runs_total{status=\"failed\"})",
            "legendFormat": "Failed",
            "refId": "B"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto"
        }
      },
      {
        "id": 2,
        "title": "Database Collections",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "sum(complira_db_documents_total)",
            "legendFormat": "Total Documents",
            "refId": "A"
          },
          {
            "expr": "sum(complira_db_edges_total)",
            "legendFormat": "Total Edges",
            "refId": "B"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 3,
        "title": "LLM Token Usage (24h)",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(increase(complira_llm_tokens_total[24h]))",
            "legendFormat": "Tokens",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 4,
        "title": "LLM Cost (24h)",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(increase(complira_llm_cost_dollars_total[24h]))",
            "legendFormat": "Cost ($)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "unit": "currencyUSD"
        }
      },
      {
        "id": 5,
        "title": "Agent Execution Duration",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(complira_agent_duration_seconds_bucket[5m])) by (le, agent_name))",
            "legendFormat": "{{agent_name}} (p95)",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Records Processed by Agent",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "expr": "sum(rate(complira_agent_records_processed_total[5m])) by (agent_name, operation)",
            "legendFormat": "{{agent_name}} - {{operation}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Records/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Circuit Breaker States",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "complira_circuit_breaker_state",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "State (0=closed, 1=open, 2=half_open)"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Database Query Performance",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(complira_db_query_duration_seconds_bucket[5m])) by (le, query_type))",
            "legendFormat": "{{query_type}} (p95)",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Top Collections by Document Count",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
        "targets": [
          {
            "expr": "topk(10, complira_db_documents_total)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "title": "LLM Confidence Scores Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
        "targets": [
          {
            "expr": "sum(rate(complira_llm_confidence_score_bucket[5m])) by (le, agent_name)",
            "legendFormat": "{{agent_name}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 11,
        "title": "HTTP Request Rate by Service",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
        "targets": [
          {
            "expr": "sum(rate(complira_http_requests_total[5m])) by (service)",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 12,
        "title": "Agent Errors",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
        "targets": [
          {
            "expr": "sum(rate(complira_agent_errors_total[5m])) by (agent_name, error_type)",
            "legendFormat": "{{agent_name}} - {{error_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Errors/sec"},
          {"format": "short"}
        ]
      }
    ]
  }
}
