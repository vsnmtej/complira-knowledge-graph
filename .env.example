# Complira Knowledge Graph Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (already in .gitignore)

# ========== ArangoDB Configuration ==========
ARANGO_URL=http://localhost:8529
ARANGO_USERNAME=root
ARANGO_PASSWORD=your_arango_password_here
ARANGO_DATABASE=complira_graph
ARANGO_MAX_CONNECTIONS=10

# ========== Anthropic API Configuration ==========
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT=60

# ========== NVD API Configuration ==========
# Get your API key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here
NVD_RATE_LIMIT_CALLS=50
NVD_RATE_LIMIT_PERIOD=30
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ========== GitHub API Configuration ==========
# Create a personal access token: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_RATE_LIMIT=5000
GITHUB_BASE_URL=https://api.github.com

# ========== VulnCheck API Configuration (Optional) ==========
# Get your API key from: https://vulncheck.com/
# Leave empty if you don't have VulnCheck access
VULNCHECK_API_KEY=
VULNCHECK_BASE_URL=https://api.vulncheck.com/v3

# ========== Prefect Configuration ==========
PREFECT_API_URL=http://localhost:4200

# ========== Monitoring Configuration ==========
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOG_LEVEL=INFO

# ========== Performance Configuration ==========
BULK_IMPORT_BATCH_SIZE=10000
MAX_CONCURRENT_AGENTS=4

# ========== LLM Cost Tracking ==========
LLM_MONTHLY_BUDGET_USD=100.0

# ========== Cloud API Configuration (Phase 0+) ==========

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Optional, leave empty if no password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# Multi-Tenant Database
ARANGO_REFERENCE_DATABASE=complira_reference  # Shared reference database
ARANGO_CUSTOMER_DATABASE_PREFIX=complira_customer_  # Customer database prefix

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=True  # Set False in production
API_DEBUG=False  # Set False in production

# Cache TTL Settings (seconds)
CACHE_TTL_REFERENCE_DATA=21600  # 6 hours
CACHE_TTL_CUSTOMER_DATA=3600  # 1 hour
CACHE_TTL_GRAPH_TRAVERSAL=1800  # 30 minutes

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Performance
MAX_REQUEST_PAYLOAD_SIZE=52428800  # 50 MB
MAX_GRAPH_TRAVERSAL_DEPTH=6
MAX_GRAPH_TRAVERSAL_TIME=30  # seconds

# ========== JWT Authentication (Phase 5 - Web UI) ==========
# MUST be a random string of at least 32 characters in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=INSECURE_DEFAULT_SECRET_CHANGE_IN_PRODUCTION

# ========== CORS Configuration ==========
# In production, set to your frontend domain:
# CORS_ALLOW_ORIGINS=["https://app.complira.com"]
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# ========== Production Environment ==========
# Set to "production" to enable security validations
ENVIRONMENT=development

# Allowed hosts (production only, comma-separated)
# ALLOWED_HOSTS=app.complira.com,api.complira.com

# ========== Frontend Configuration ==========
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# ========== Docker Compose Required ==========
# These are required when running docker-compose up:
GRAFANA_PASSWORD=your_grafana_password_here
